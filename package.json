{
  "name": "@saiuttej/nestjs-encryptions",
  "version": "0.2.0",
  "description": "A NestJS module for encrypting and decrypting data using AES-256-CBC algorithm. Supports both synchronous and asynchronous operations and Hasher class for hashing and verifying data using bcrypt.",
  "author": "B Sai Uttej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saiuttej-b/nestjs-encryptions"
  },
  "bugs": {
    "url": "https://github.com/saiuttej-b/nestjs-encryption/issues"
  },
  "keywords": [
    "nestjs",
    "encryption",
    "aes-256-cbc"
  ],
  "main": "dist/index.js",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepublish": "npm run build",
    "start": "ts-node src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "local": "pnpm i && pnpm build && pnpm pack"
  },
  "packageManager": "pnpm@10.15.0",
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "bcrypt": "^6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
